# Copy to .env.local for LOCAL development only. Never commit real values.
# Production values are set separately in Vercel (Settings > Environment
# Variables) — local and production settings never share a file.
# See docs/setup.md for where to obtain each value.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either name works (Supabase renamed anon key -> publishable key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (no trailing slash)
# Local (.env.local): http://localhost:3000
# Production (Vercel env vars): https://p12vizha.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal (developer.paypal.com > Apps & Credentials > Sandbox)
# Required only for Phase 4 paid checkout. Leave blank for free-event work.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Resend (resend.com > API Keys) — registration confirmation emails.
# Server-only. Leave blank to disable confirmation emails.
# EMAIL_FROM defaults to Resend's test sender (onboarding@resend.dev),
# which can only email your own Resend account address. Verify a domain
# in Resend and set EMAIL_FROM to send to attendees in production.
RESEND_API_KEY=
EMAIL_FROM=
