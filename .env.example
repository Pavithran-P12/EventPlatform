# Copy to .env.local for local development. Never commit real values.
# See docs/setup.md for where to obtain each value.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal (developer.paypal.com > Apps & Credentials > Sandbox)
# Required only for Phase 4 paid checkout. Leave blank for free-event work.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
